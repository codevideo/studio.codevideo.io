# CodeVideo Studio local development

# Clerk public browser key. Required for sign-in and authenticated API calls.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# CodeVideo API base URL. Local video export expects codevideo-api on 7000.
NEXT_PUBLIC_CODEVIDEO_API_URL=http://localhost:7000

# Optional backend used by referral/token invitation UI.
NEXT_PUBLIC_API_URL=

# Stripe links used by account/pricing/top-up UI.
NEXT_PUBLIC_STRIPE_CUSTOMER_PORTAL_LINK=
NEXT_PUBLIC_STRIPE_STARTER_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_CREATOR_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_ENTERPRISE_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_LIFETIME_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_TOPUP_PAYMENT_LINK=
NEXT_PUBLIC_STRIPE_STARTER_MONTHLY_LINK=
